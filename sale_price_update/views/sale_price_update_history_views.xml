<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Lista ── -->
    <record id="view_sale_price_update_history_list" model="ir.ui.view">
        <field name="name">sale.price.update.history.list</field>
        <field name="model">sale.price.update.history</field>
        <field name="arch" type="xml">
            <list string="Historial de Actualización de Precios" default_order="date_applied desc">
                <field name="date_applied"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="pricelist_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="old_price" string="Precio Anterior"/>
                <field name="increase_percent" string="% Aumento" widget="percentage"/>
                <field name="new_price" string="Precio Nuevo"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- ── Formulario ── -->
    <record id="view_sale_price_update_history_form" model="ir.ui.view">
        <field name="name">sale.price.update.history.form</field>
        <field name="model">sale.price.update.history</field>
        <field name="arch" type="xml">
            <form string="Historial de Precio" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Producto">
                            <field name="product_id"/>
                            <field name="categ_id"/>
                            <field name="pricelist_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Cambio aplicado">
                            <field name="date_applied"/>
                            <field name="old_price"/>
                            <field name="increase_percent" widget="percentage"/>
                            <field name="new_price"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Búsqueda ── -->
    <record id="view_sale_price_update_history_search" model="ir.ui.view">
        <field name="name">sale.price.update.history.search</field>
        <field name="model">sale.price.update.history</field>
        <field name="arch" type="xml">
            <search string="Historial de Precios">
                <field name="product_id"/>
                <field name="pricelist_id"/>
                <field name="categ_id"/>
                <field name="user_id"/>
                <filter string="Hoy" name="today" domain="[('date_applied','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Este mes" name="this_month"
                    domain="[('date_applied','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Lista de Precios" name="group_pricelist" context="{'group_by': 'pricelist_id'}"/>
                    <filter string="Categoría" name="group_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date_applied:month'}"/>
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción ── -->
    <record id="action_sale_price_update_history" model="ir.actions.act_window">
        <field name="name">Historial de Actualización de Precios</field>
        <field name="res_model">sale.price.update.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_price_update_history_search"/>
    </record>

</odoo>
